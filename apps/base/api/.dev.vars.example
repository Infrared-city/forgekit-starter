# Copy this file to apps/base/api/.dev.vars (git ignores .dev.vars) and fill it in.
# For a deployed Worker use `npx wrangler secret put INFRARED_API_KEY --env production`.

# Your Infrared API key. Create one in your Infrared account
# (https://platform.infrared.city) or use the key your workshop gave you.
# Never commit it, never put it in browser code.
INFRARED_API_KEY=

# Optional. Maintainers only: another API base URL (for example staging).
# INFRARED_BASE_URL=

# Optional. Only for the reference app's /places search (Google Maps Platform key).
GOOGLE_MAPS_API_KEY=
