# Copy this file to apps/base/api/.dev.vars (git ignores .dev.vars) and fill it in.
# For a deployed Worker use `npx wrangler secret put INFRARED_API_KEY --env production`.

# Your Infrared API key. Create one in your Infrared account
# (https://platform.infrared.city) or use the key your workshop gave you.
# Never commit it, never put it in browser code.
INFRARED_API_KEY=

# Local development only: lets the proxy run without APP_PASSWORD on
# localhost. A deployed Worker never reads this file, so there it has no
# effect: without APP_PASSWORD the deployed proxy answers 503.
ALLOW_OPEN_PROXY_FOR_LOCAL_DEV=true

# A shared password: requests without the header `X-App-Password: <this>`
# get 401. REQUIRED for a deployed Worker (`wrangler secret put APP_PASSWORD`).
# Optional here; set it to try the password flow locally.
APP_PASSWORD=

# Optional. Maintainers only: another API base URL (for example staging).
# INFRARED_BASE_URL=

# Optional. Only for the reference app's /places search (Google Maps Platform key).
GOOGLE_MAPS_API_KEY=
