{
  "name": "forgekit-starter",
  "private": true,
  "scripts": {
    "dev": "npm run dev:api & npm run dev:examples",
    "dev:api": "npm run dev --workspace apps/base/api",
    "dev:examples": "npm run dev --workspace apps/examples",
    "dev:client": "npm run dev --workspace apps/base/client",
    "build": "npm run build --workspace apps/examples",
    "build:client": "npm run build --workspace apps/base/client",
    "typecheck": "npm run typecheck --workspace apps/examples",
    "update-sdk": "node scripts/update-sdk.mjs",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "test": "npm run test:run --workspaces --if-present"
  },
  "workspaces": [
    "apps/*",
    "apps/base/*",
    "packages/*",
    "packages/primitives/*",
    "packages/interfaces/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@testing-library/dom": "^10.4.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "fflate": "^0.8.3",
    "image-size": "^2.0.3"
  }
}
